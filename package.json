  "dependencies": {
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "archiver": "^6.0.1",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "express": "^4.19.2",
    "socks-proxy-agent": "^8.0.5",
    "tough-cookie": "^5.1.2",
    "ws": "^8.18.0",
    "youtubei.js": "^12.0.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
